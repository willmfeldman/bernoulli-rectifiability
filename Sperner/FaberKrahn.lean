module

public import Sperner.Compactness
public import Sperner.CapSymmetry
public import Sperner.Picone

/-!
# Gaussian Faber–Krahn inequality at the half-space threshold

For a one-homogeneous, nonnegative, Lipschitz function `f` on `ℝⁿ` whose positivity set has
Gaussian measure at most half of the total, `∫ f² dγ ≤ ∫ |Df|² dγ`; if the positivity set has
measure strictly less than half and `f ≢ 0`, the inequality is strict (`n ≥ 2`).

In spherical language: a spherical domain `Ω` with `|Ω| ≤ |S^{n-1}|/2` has first Dirichlet
eigenvalue `λ₁(Ω) ≥ n - 1`, strictly if `|Ω| < |S^{n-1}|/2` (E. Sperner, Jr., *Zur
Symmetrisierung von Funktionen auf Sphären*, Math. Z. 134 (1973), 317–327).

## Proof route

Two-point rearrangement (polarization) in `ℝⁿ` with respect to hyperplanes through `0`
preserves the class of competitors and increases `J_e(w) = ∫ w ⟪x, e⟫ dγ`. A maximizer of `J_e`
over the (compact) closed class is invariant under all polarizations that favour `e`, hence
cap-symmetric about `e`; its support is then contained in a cone `{⟪x, e⟫ ≥ s |x|}` with `s > 0`
(or in the half-space when the measure is exactly half). A Picone identity with the
supersolution `⟪x, e⟫ - c |x|` then gives the strict Gaussian Poincaré inequality there.
-/

open MeasureTheory Set
open scoped NNReal RealInnerProductSpace

@[expose] public noncomputable section

namespace Sperner

variable {n : ℕ}

lemma integrable_sq_of_lipschitzWith {f : EuclideanSpace ℝ (Fin n) → ℝ} {L : ℝ≥0}
    (hf : LipschitzWith L f) (h0 : f 0 = 0) :
    Integrable (fun x => f x ^ 2) (gaussMeasure n) :=
  ((integrable_norm_pow_gaussMeasure (n := n) 2).const_mul ((L : ℝ) ^ 2)).mono'
    (hf.continuous.pow 2).aestronglyMeasurable
    (ae_of_all _ fun x => by
      rw [Real.norm_of_nonneg (sq_nonneg _), ← mul_pow, ← sq_abs (f x)]
      exact pow_le_pow_left₀ (abs_nonneg _) (abs_le_of_lipschitzWith_of_map_zero hf h0 x) 2)

lemma gaussL2_pos_of_ne_zero {f : EuclideanSpace ℝ (Fin n) → ℝ} {L : ℝ≥0}
    (hf : LipschitzWith L f) (h0 : f 0 = 0) {x₀ : EuclideanSpace ℝ (Fin n)} (hx₀ : f x₀ ≠ 0) :
    0 < gaussL2 f := by
  unfold gaussL2
  rw [integral_pos_iff_support_of_nonneg (fun x => sq_nonneg _)
    (integrable_sq_of_lipschitzWith hf h0)]
  exact lt_of_lt_of_le (gaussMeasure_pos_of_isOpen
    (isOpen_ne_fun hf.continuous continuous_const) ⟨x₀, hx₀⟩)
    (measure_mono fun x (hx : f x ≠ 0) => pow_ne_zero 2 hx)

/-- The maximizer of `J_e` over the admissible class generated by `f` is invariant under every
polarization favouring `e`. -/
lemma exists_admissible_sym {f : EuclideanSpace ℝ (Fin n) → ℝ} {L : ℝ≥0}
    (hf : LipschitzWith L f) (hnn : ∀ x, 0 ≤ f x) (hhom : IsOneHomogeneous f)
    (e : EuclideanSpace ℝ (Fin n)) :
    ∃ w, AdmissibleClass L (dirichletEnergy f) (gaussL2 f) (gaussMeasure n {x | 0 < f x}) w ∧
      ∀ a : EuclideanSpace ℝ (Fin n), ‖a‖ = 1 → 0 < ⟪a, e⟫ →
        ∀ x, 0 < ⟪x, a⟫ → w (reflect a x) ≤ w x := by
  have hA : AdmissibleClass L (dirichletEnergy f) (gaussL2 f) (gaussMeasure n {x | 0 < f x}) f :=
    ⟨hf, hnn, hhom, rfl, le_rfl, le_rfl⟩
  obtain ⟨w, hw, hmax⟩ := exists_isMaxOn_gaussMoment e hA
  refine ⟨w, hw, fun a ha hae x hx => ?_⟩
  have hw0 : w 0 = 0 := hw.2.2.1.map_zero
  have h1 := hmax _ (AdmissibleClass.polarize ha hw)
  have h2 := gaussMoment_le_polarize ha hae.le hw.1 hw0
  exact le_of_gaussMoment_polarize_eq ha hae hw.1 hw0 (le_antisymm h1 h2) hx

lemma exists_unit_vector (hn : 2 ≤ n) : ∃ e : EuclideanSpace ℝ (Fin n), ‖e‖ = 1 :=
  ⟨EuclideanSpace.single ⟨0, by omega⟩ 1, by simp⟩

/-- **Gaussian Faber–Krahn, strict form.** If the positivity set of a nonzero, nonnegative,
one-homogeneous Lipschitz `f` has Gaussian measure less than half of the total, then
`∫ f² dγ < ∫ |Df|² dγ`. -/
theorem gaussL2_lt_dirichletEnergy (hn : 2 ≤ n) {f : EuclideanSpace ℝ (Fin n) → ℝ} {L : ℝ≥0}
    (hf : LipschitzWith L f) (hnn : ∀ x, 0 ≤ f x) (hhom : IsOneHomogeneous f)
    (hpos : ∃ x, 0 < f x) (hsmall : 2 * gaussMeasure n {x | 0 < f x} < gaussMeasure n univ) :
    gaussL2 f < dirichletEnergy f := by
  obtain ⟨e, he⟩ := exists_unit_vector hn
  obtain ⟨w, ⟨hwL, hwnn, hwhom, hwM, hwD, hwm⟩, hsym⟩ := exists_admissible_sym hf hnn hhom e
  have hsmall' : 2 * gaussMeasure n {x | 0 < w x} < gaussMeasure n univ :=
    lt_of_le_of_lt (mul_le_mul_right hwm 2) hsmall
  obtain ⟨s, hs, hcone⟩ := exists_cone_of_two_mul_lt he hwnn hwhom hsym hsmall'
  have hwpos : ∃ x, 0 < w x := by
    obtain ⟨x₀, hx₀⟩ := hpos
    have hL2 : 0 < gaussL2 w := hwM ▸ gaussL2_pos_of_ne_zero hf hhom.map_zero hx₀.ne'
    by_contra h
    push Not at h
    have : ∀ x, w x = 0 := fun x => le_antisymm (h x) (hwnn x)
    simp [gaussL2, this] at hL2
  have := gaussL2_lt_dirichletEnergy_of_subset_cone hn hwL hwnn hwhom hs hcone hwpos
  rw [hwM] at this
  exact this.trans_le hwD

/-- **Gaussian Faber–Krahn, non-strict form at the threshold.** If the positivity set of a
nonnegative one-homogeneous Lipschitz `f` has Gaussian measure at most half of the total, then
`∫ f² dγ ≤ ∫ |Df|² dγ`. -/
theorem gaussL2_le_dirichletEnergy (hn : 2 ≤ n) {f : EuclideanSpace ℝ (Fin n) → ℝ} {L : ℝ≥0}
    (hf : LipschitzWith L f) (hnn : ∀ x, 0 ≤ f x) (hhom : IsOneHomogeneous f)
    (hhalf : 2 * gaussMeasure n {x | 0 < f x} ≤ gaussMeasure n univ) :
    gaussL2 f ≤ dirichletEnergy f := by
  obtain ⟨e, he⟩ := exists_unit_vector hn
  obtain ⟨w, ⟨hwL, hwnn, hwhom, hwM, hwD, hwm⟩, hsym⟩ := exists_admissible_sym hf hnn hhom e
  have hhalf' : 2 * gaussMeasure n {x | 0 < w x} ≤ gaussMeasure n univ :=
    (mul_le_mul_right hwm 2).trans hhalf
  have hH := inner_pos_of_two_mul_le he hwL.continuous hwhom hsym hhalf'
  have := gaussL2_le_dirichletEnergy_of_subset_halfSpace hwL hwnn hwhom he hH
  rw [hwM] at this
  exact this.trans hwD

end Sperner
